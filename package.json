{
  "name": "sh-meta-games",
  "version": "0.2.0",
  "private": true,
  "description": "Metagame e diário competitivo para Pokémon TCG Standard Online.",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test",
    "typecheck": "npm --prefix apps/web run typecheck",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "data:from-csv": "python3 scripts/build_snapshot_from_csv.py"
  },
  "engines": {
    "node": ">=20.9",
    "python": ">=3.12"
  }
}
